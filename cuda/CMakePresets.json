{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Settings shared by the Windows presets. Run from a Developer PowerShell so cl.exe is on PATH.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows (Ninja, Debug)",
      "description": "Single-config Debug build.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows (Ninja, Release)",
      "description": "Single-config Release build.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows (Ninja, Debug)",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows (Ninja, Release)",
      "configurePreset": "windows-release"
    }
  ]
}
